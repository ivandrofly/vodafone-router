<Window x:Class="VodafoneRouter.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VodafoneRouter.Wpf"
        Title="Vodafone Smart Router"
        Width="900" Height="620"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance Type=local:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="SelectionMode" Value="Single" />
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Connection bar -->
        <Border Grid.Row="0" Padding="8" Background="#F3F3F3" CornerRadius="4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Router:" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBox Width="170" VerticalAlignment="Center"
                         Text="{Binding RouterUrl, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsNotConnected}" />
                <TextBlock Text="User:" VerticalAlignment="Center" Margin="12,0,4,0" />
                <TextBox Width="100" VerticalAlignment="Center"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsNotConnected}" />
                <TextBlock Text="Password:" VerticalAlignment="Center" Margin="12,0,4,0" />
                <PasswordBox x:Name="PasswordInput" Width="140" VerticalAlignment="Center"
                             PasswordChanged="PasswordInput_PasswordChanged"
                             IsEnabled="{Binding IsNotConnected}" />
                <Button Content="Connect" Width="90" Margin="12,0,0,0" Padding="4"
                        Command="{Binding ConnectCommand}" IsDefault="True" />
                <Button Content="Disconnect" Width="90" Margin="6,0,0,0" Padding="4"
                        Command="{Binding DisconnectCommand}" />
                <Button Content="Refresh" Width="90" Margin="18,0,0,0" Padding="4"
                        Command="{Binding RefreshCommand}" />
                <Button Content="Reboot…" Width="90" Margin="6,0,0,0" Padding="4"
                        Command="{Binding RebootCommand}" />
            </StackPanel>
        </Border>

        <!-- Data tabs -->
        <TabControl Grid.Row="1" Margin="0,10,0,0" IsEnabled="{Binding IsConnected}">
            <TabItem Header="Overview">
                <Grid Margin="12" DataContext="{Binding Overview}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="Margin" Value="0,4,16,4" />
                            <Setter Property="FontSize" Value="14" />
                        </Style>
                    </Grid.Resources>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Product:" FontWeight="Bold" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ProductName}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Firmware:" FontWeight="Bold" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FirmwareVersion}" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="WAN IPv4:" FontWeight="Bold" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding WanIPv4}" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="WAN IPv6:" FontWeight="Bold" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding WanIPv6}" />
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Uptime:" FontWeight="Bold" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding UptimeText}" />
                </Grid>
            </TabItem>

            <TabItem Header="WAN">
                <DataGrid ItemsSource="{Binding Wans}" Margin="4">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="140" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                        <DataGridTextColumn Header="Type" Binding="{Binding ConnectionType}" Width="80" />
                        <DataGridTextColumn Header="IP address" Binding="{Binding IpAddress}" Width="120" />
                        <DataGridTextColumn Header="Gateway" Binding="{Binding Gateway}" Width="120" />
                        <DataGridTextColumn Header="DNS" Binding="{Binding Dns}" Width="160" />
                        <DataGridTextColumn Header="Bytes sent" Binding="{Binding BytesSent}" Width="100" />
                        <DataGridTextColumn Header="Bytes received" Binding="{Binding BytesReceived}" Width="110" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Wi-Fi">
                <DataGrid ItemsSource="{Binding Wlans}" Margin="4">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Interface" Binding="{Binding InterfaceName}" Width="120" />
                        <DataGridCheckBoxColumn Header="Service enabled" Binding="{Binding ServiceEnabled, Mode=OneWay}" Width="120" />
                        <DataGridCheckBoxColumn Header="Radio enabled" Binding="{Binding RadioEnabled, Mode=OneWay}" Width="120" />
                        <DataGridTextColumn Header="Domain" Binding="{Binding Domain}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Devices">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                        <CheckBox Content="Active only" IsChecked="{Binding ShowActiveOnly}"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DeviceCountText}" Margin="16,0,0,0"
                                   VerticalAlignment="Center" Foreground="Gray" />
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding DevicesView}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Host name" Binding="{Binding HostName}" Width="180" />
                            <DataGridTextColumn Header="Alias" Binding="{Binding Alias}" Width="120" />
                            <DataGridTextColumn Header="IP address" Binding="{Binding IpAddress}" Width="120" />
                            <DataGridTextColumn Header="MAC address" Binding="{Binding MacAddress}" Width="140" />
                            <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="90" />
                            <DataGridCheckBoxColumn Header="Wireless" Binding="{Binding IsWireless, Mode=OneWay}" Width="70" />
                            <DataGridCheckBoxColumn Header="Online" Binding="{Binding IsActive, Mode=OneWay}" Width="60" />
                            <DataGridTextColumn Header="Online for" Binding="{Binding OnlineDuration}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Status bar -->
        <StatusBar Grid.Row="2" Margin="0,8,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar Width="120" Height="12" IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
