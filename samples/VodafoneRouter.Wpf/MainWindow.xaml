<Window x:Class="VodafoneRouter.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VodafoneRouter.Wpf"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:MainViewModel}"
        Title="Vodafone Smart Router"
        Width="980" Height="680"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        FontFamily="{materialDesign:MaterialDesignFont}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style TargetType="DataGrid" BasedOn="{StaticResource MaterialDesignDataGrid}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="materialDesign:DataGridAssist.CellPadding" Value="8" />
            <Setter Property="materialDesign:DataGridAssist.ColumnHeaderPadding" Value="8" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- App bar -->
        <materialDesign:ColorZone Grid.Row="0" Mode="PrimaryMid" Padding="16,12"
                                  materialDesign:ElevationAssist.Elevation="Dp4">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="RouterWireless" Width="28" Height="28"
                                         VerticalAlignment="Center" />
                <TextBlock Text="Vodafone Smart Router" FontSize="19" FontWeight="Medium"
                           Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </materialDesign:ColorZone>

        <!-- Connection card -->
        <materialDesign:Card Grid.Row="1" Margin="16,16,16,0" Padding="16,8,16,12">
            <StackPanel Orientation="Horizontal">
                <TextBox Width="180" VerticalAlignment="Bottom"
                         materialDesign:HintAssist.Hint="Router URL"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         Text="{Binding RouterUrl, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsNotConnected}" />
                <TextBox Width="120" Margin="16,0,0,0" VerticalAlignment="Bottom"
                         materialDesign:HintAssist.Hint="Username"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsNotConnected}" />
                <PasswordBox x:Name="PasswordInput" Width="150" Margin="16,0,0,0" VerticalAlignment="Bottom"
                             materialDesign:HintAssist.Hint="Password"
                             Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                             PasswordChanged="PasswordInput_PasswordChanged"
                             IsEnabled="{Binding IsNotConnected}" />

                <Button Margin="24,0,0,0" VerticalAlignment="Bottom"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Command="{Binding ConnectCommand}" IsDefault="True">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="LanConnect" VerticalAlignment="Center" />
                        <TextBlock Text="Connect" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Margin="8,0,0,0" VerticalAlignment="Bottom"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Command="{Binding DisconnectCommand}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="LanDisconnect" VerticalAlignment="Center" />
                        <TextBlock Text="Disconnect" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Margin="24,0,0,0" VerticalAlignment="Bottom"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" VerticalAlignment="Center" />
                        <TextBlock Text="Refresh" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Margin="8,0,0,0" VerticalAlignment="Bottom"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Command="{Binding RebootCommand}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Restart" VerticalAlignment="Center" />
                        <TextBlock Text="Reboot" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </materialDesign:Card>

        <!-- Data tabs -->
        <TabControl Grid.Row="2" Margin="16,12,16,0" IsEnabled="{Binding IsConnected}"
                    materialDesign:ColorZoneAssist.Mode="PrimaryMid">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="InformationOutline" VerticalAlignment="Center" />
                        <TextBlock Text="Overview" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <materialDesign:Card Margin="0,12,0,12" Padding="24" VerticalAlignment="Top"
                                     HorizontalAlignment="Left" MinWidth="440"
                                     DataContext="{Binding Overview}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.Resources>
                            <Style TargetType="materialDesign:PackIcon">
                                <Setter Property="Width" Value="22" />
                                <Setter Property="Height" Value="22" />
                                <Setter Property="Margin" Value="0,6,16,6" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Margin" Value="0,6,24,6" />
                                <Setter Property="FontSize" Value="14" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </Grid.Resources>

                        <materialDesign:PackIcon Grid.Row="0" Grid.Column="0" Kind="RouterWireless" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Product" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding ProductName}" FontWeight="Medium" />

                        <materialDesign:PackIcon Grid.Row="1" Grid.Column="0" Kind="Chip" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Firmware" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding FirmwareVersion}" FontWeight="Medium" />

                        <materialDesign:PackIcon Grid.Row="2" Grid.Column="0" Kind="IpNetwork" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="WAN IPv4" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding WanIPv4}" FontWeight="Medium" />

                        <materialDesign:PackIcon Grid.Row="3" Grid.Column="0" Kind="IpNetworkOutline" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="WAN IPv6" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding WanIPv6}" FontWeight="Medium" />

                        <materialDesign:PackIcon Grid.Row="4" Grid.Column="0" Kind="ClockOutline" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="Uptime" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding UptimeText}" FontWeight="Medium" />
                    </Grid>
                </materialDesign:Card>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Web" VerticalAlignment="Center" />
                        <TextBlock Text="WAN" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <DataGrid ItemsSource="{Binding Wans}" Margin="0,12,0,12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" />
                        <DataGridTextColumn Header="Type" Binding="{Binding ConnectionType}" Width="90" />
                        <DataGridTextColumn Header="IP address" Binding="{Binding IpAddress}" Width="130" />
                        <DataGridTextColumn Header="Gateway" Binding="{Binding Gateway}" Width="130" />
                        <DataGridTextColumn Header="DNS" Binding="{Binding Dns}" Width="170" />
                        <DataGridTextColumn Header="Bytes sent" Binding="{Binding BytesSent}" Width="110" />
                        <DataGridTextColumn Header="Bytes received" Binding="{Binding BytesReceived}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Wifi" VerticalAlignment="Center" />
                        <TextBlock Text="Wi-Fi" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <DataGrid ItemsSource="{Binding Wlans}" Margin="0,12,0,12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Interface" Binding="{Binding InterfaceName}" Width="130" />
                        <DataGridCheckBoxColumn Header="Service enabled" Binding="{Binding ServiceEnabled, Mode=OneWay}" Width="130" />
                        <DataGridCheckBoxColumn Header="Radio enabled" Binding="{Binding RadioEnabled, Mode=OneWay}" Width="130" />
                        <DataGridTextColumn Header="Domain" Binding="{Binding Domain}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Devices" VerticalAlignment="Center" />
                        <TextBlock Text="Devices" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,12,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                      IsChecked="{Binding ShowActiveOnly}" VerticalAlignment="Center" />
                        <TextBlock Text="Active only" Margin="10,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DeviceCountText}" Margin="24,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}" />
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding DevicesView}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Host name" Binding="{Binding HostName}" Width="190" />
                            <DataGridTextColumn Header="Alias" Binding="{Binding Alias}" Width="120" />
                            <DataGridTextColumn Header="IP address" Binding="{Binding IpAddress}" Width="130" />
                            <DataGridTextColumn Header="MAC address" Binding="{Binding MacAddress}" Width="150" />
                            <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="100" />
                            <DataGridCheckBoxColumn Header="Wireless" Binding="{Binding IsWireless, Mode=OneWay}" Width="80" />
                            <DataGridCheckBoxColumn Header="Online" Binding="{Binding IsActive, Mode=OneWay}" Width="70" />
                            <DataGridTextColumn Header="Online for" Binding="{Binding OnlineDuration}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Status bar -->
        <materialDesign:ColorZone Grid.Row="3" Mode="Light" Padding="16,8" Margin="0,12,0,0"
                                  materialDesign:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" VerticalAlignment="Center" />
                <ProgressBar Grid.Column="1" Width="140" Height="6" IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </materialDesign:ColorZone>
    </Grid>
</Window>
